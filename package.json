{
  "name": "vention",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "tsx scripts/start.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "typecheck": "tsc -p scripts && npm run typecheck --workspace server",
    "build": "npm run build --workspace web",
    "test:ui": "vitest --ui"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/ui": "^5.0.4",
    "concurrently": "^10.0.6",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  },
  "workspaces": [
    "server",
    "web"
  ]
}
